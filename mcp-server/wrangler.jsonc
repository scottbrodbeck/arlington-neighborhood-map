{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arlnow-neighborhoods-mcp",
  "main": "src/index.js",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // McpAgent keeps per-session state in a Durable Object — boilerplate; our
  // tools are stateless but the agents SDK routes sessions through it.
  "migrations": [{ "new_sqlite_classes": ["NeighborhoodMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "NeighborhoodMCP", "name": "MCP_OBJECT" }]
  },
  // Abuse cap on /mcp, keyed by client IP. claude.ai calls share Anthropic
  // egress IPs, so this caps aggregate connector traffic. period must be 10 or 60.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  }
}
